---
// Maison — base layout: printed light aesthetic. Archive-house tabs in the
// top bar, serif masthead, Collections mega with a house manifesto, ⌘K
// search over every house, piece drawer, private vault + acquisition bag
// (no checkout — "Request the keeper"), patron auth and live currency.
import '../styles/global.css';
import { commerce, providerName } from '../lib/commerce';
import catalog from '../data/mock-catalog.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'Maison — classic archive storefront theme for Astro',
  description = 'A printed, editorial light theme: three archive houses, faceted catalogue, patron cabinet, private vault and live currency switching. Astro + Tailwind v4, Shopify-ready.',
  ogImage,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://astro-njx-maison.pages.dev')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageURL = new URL(ogImage ?? '/logo/maison-og.png', siteOrigin).href;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Maison',
  url: siteOrigin,
});

const products = await commerce.listProducts();
const clientData = JSON.stringify({
  houses: catalog.collections,
  pieces: products.map((p) => ({
    id: (p as any).id,
    handle: p.handle,
    name: p.title,
    brand: (p as any).vendor ?? '',
    house: p.collectionHandles[0],
    price: p.price.amount,
    image: p.images[0]?.src ?? '',
    ref: (p as any).meta?.ref ?? '',
    material: (p as any).meta?.material ?? '',
    epoch: (p as any).meta?.epoch ?? '',
    origin: (p as any).meta?.origin ?? '',
    rating: (p as any).meta?.rating ?? 0,
    stock: (p as any).meta?.stock ?? false,
    bespoke: (p as any).meta?.bespoke ?? false,
    kind: (p as any).meta?.kind ?? '',
    note: (p as any).meta?.note ?? '',
    spec: (p as any).meta?.spec ?? '',
  })),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maison" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={orgLd} />
    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Karla:wght@300;400;500;600&family=Cousine:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper font-sans text-ink antialiased" data-provider={providerName} data-maison={clientData}>

    <!-- ── Archive-house strip ── -->
    <div class="border-b border-line bg-tint">
      <div class="eti mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-[22px] gap-y-2 px-3 py-1.5 sm:px-6 sm:py-[9px]">
        <span class="hidden text-faint sm:inline">Archive houses</span>
        <span data-house-tabs class="hidden flex-wrap gap-x-4 gap-y-1 sm:flex sm:gap-x-[22px]"></span>
        <span class="relative sm:hidden" data-house-dd>
          <button data-house-dd-btn class="flex cursor-pointer items-center gap-1.5 text-ink">
            <span data-house-dd-label class="tab-on"></span><span class="text-[9px] text-faint">▾</span>
          </button>
          <span data-house-dd-list class="absolute left-0 top-[calc(100%+7px)] z-40 hidden min-w-[190px] flex-col gap-2.5 border border-line bg-card p-3 shadow-[0_18px_32px_-24px_oklch(0.22_0.006_0/0.35)] [&.open]:flex"></span>
        </span>
        <span class="flex-1"></span>
        <a href="https://github.com" target="_blank" rel="noopener" class="hidden text-soft transition hover:text-acc sm:inline">GitHub</a>
        <span data-house-meta class="hidden text-faint sm:inline"></span>
      </div>
    </div>

    <!-- ── Masthead ── -->
    <header class="sticky top-0 z-30 border-b border-rule bg-card">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-3 gap-y-2 p-2 sm:gap-x-[26px] sm:gap-y-3.5 sm:px-6 sm:py-3.5">
        <a href="/" data-house-name class="font-sf order-1 min-w-0 flex-1 basis-auto text-[18px] tracking-[0.01em] text-ink sm:order-none sm:text-[20px]"></a>
        <nav class="order-3 flex basis-full flex-wrap items-center justify-between gap-x-4 gap-y-2 text-[13.5px] tracking-[0.02em] sm:order-none sm:basis-auto sm:justify-start sm:gap-[22px]">
          <button data-mega-btn class="cursor-pointer pb-0.5 text-soft transition hover:text-acc [&.open]:text-acc [&.open]:border-b [&.open]:border-acc">Collections</button>
          <a href="/#archive" class="text-soft transition hover:text-acc">Archive</a>
          <button data-vault-btn title="Private vault" class="flex cursor-pointer items-center gap-1.5 text-soft transition hover:text-acc">
            <svg data-vault-ico class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span><span class="hidden sm:inline">Saved · </span><span data-vault-n>0</span></span>
          </button>
          <button data-bag-btn title="Acquisition bag" class="flex cursor-pointer items-center gap-1.5 text-soft transition hover:text-acc">
            <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span><span class="hidden sm:inline">Bag · </span><span data-bag-n>0</span></span>
          </button>
          <a href="/account" data-patron-link class="hidden tab-on [&.show]:inline"></a>
          <button data-auth-btn class="btn-keeper px-2.5 py-[7px] sm:px-3.5 [&.hide]:hidden">Sign in</button>
        </nav>
        <button data-search-open class="order-2 flex flex-none cursor-pointer items-center gap-3 rounded-[2px] border border-rule px-2 py-[7px] text-[13px] text-muted transition hover:border-faint sm:order-none sm:min-w-[132px] sm:basis-[200px] sm:px-3">
        <svg class="ico-sm sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="hidden flex-1 text-left sm:block">Search</span>
          <span class="hidden font-mono text-[11px] text-faint sm:inline">⌘K</span>
        </button>
      </div>

      <!-- Collections mega -->
      <div data-mega class="hidden max-h-[calc(100vh-110px)] overflow-y-auto overscroll-contain border-t border-line bg-card shadow-[0_18px_32px_-24px_oklch(0.22_0.006_0/0.35)] [&.open]:block lg:max-h-none lg:overflow-visible">
        <div class="relative mx-auto flex max-w-[1240px] flex-wrap gap-10 px-6 pb-[38px] pt-[34px]">
          <button data-mega-close class="absolute right-6 top-4 cursor-pointer font-mono text-[12px] text-soft transition hover:text-acc">Close ✕</button>
          <div data-mega-cols class="flex min-w-0 flex-[3_1_480px] flex-wrap gap-10"></div>
          <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-3.5 border-l border-line pl-8">
            <div data-mega-visual class="hatch flex aspect-video items-end border border-line bg-cover bg-center p-3">
              <span data-mega-image class="bg-card px-1.5 py-[3px] font-mono text-[10px] tracking-[0.08em] text-faint"></span>
            </div>
            <div data-mega-title class="font-sf text-[17px] leading-[1.3]"></div>
            <p data-mega-manifesto class="m-0 text-[13px] leading-[1.7] text-soft"></p>
          </div>
        </div>
      </div>
    </header>

    <slot />

    <!-- ── Footer ── -->
    <footer class="mt-20 border-t border-line bg-tint">
      <div class="eti mx-auto flex max-w-[1240px] flex-col gap-3 px-3 py-5 text-faint sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-3 sm:px-6 sm:py-6">
        <span class="hidden lg:inline">Astro · Tailwind v4 · Shopify Storefront API</span>
        <span class="flex flex-wrap gap-x-5 gap-y-1.5">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="text-soft transition hover:text-acc">Instagram</a>
          <a href="https://github.com" target="_blank" rel="noopener" class="text-acc hover:text-acc-deep">GitHub</a>
        </span>
      </div>
    </footer>

    <!-- ── Thank-you popup ── -->
    <div data-thanks-modal class="fixed inset-0 z-[60] hidden items-center justify-center bg-[oklch(0.22_0.006_0/0.42)] p-2.5 sm:p-6 [&.open]:flex">
      <div class="flex w-[min(440px,100%)] flex-col gap-4 border border-line bg-card p-4 shadow-[0_24px_48px_-24px_oklch(0.22_0.006_0/0.5)] sm:gap-5 sm:p-7">
        <div class="flex items-baseline">
          <span class="eti text-acc">Merci · thank you</span>
          <span class="flex-1"></span>
          <button data-thanks-close class="cursor-pointer font-mono text-[12px] text-soft transition hover:text-acc">Close ✕</button>
        </div>
        <h3 class="font-sf m-0 text-[24px] leading-[1.25]">The keeper has your request</h3>
        <p class="m-0 text-[13.5px] leading-[1.7] text-soft">This is a demo store, so nothing was charged. A confirmation would normally reach your inbox in a minute — thank you for your request.</p>
        <a href="/" class="btn-keeper px-5 py-3.5 text-center">Continue browsing</a>
        <p class="m-0 text-[12.5px] leading-[1.7] text-muted">Complimentary shipping over €200 · considered, archival packaging on every order.</p>
      </div>
    </div>

    <!-- ── Piece drawer ── -->
    <div data-piece-modal class="fixed inset-0 z-40 hidden justify-end bg-[oklch(0.22_0.006_0/0.42)] [&.open]:flex">
      <div data-piece-box class="anim-slide w-[min(560px,100%)] overflow-y-auto border-l border-rule bg-paper p-[clamp(20px,4vw,40px)]"></div>
    </div>

    <!-- ── Private vault drawer ── -->
    <div data-vault-modal class="fixed inset-0 z-[45] hidden justify-end bg-[oklch(0.22_0.006_0/0.42)] [&.open]:flex">
      <div class="anim-slide flex w-[min(480px,100%)] flex-col gap-[22px] overflow-y-auto border-l border-rule bg-paper p-[clamp(20px,4vw,36px)]">
        <div class="flex items-baseline gap-4">
          <span class="eti text-faint">Saved pieces</span>
          <span class="flex-1"></span>
          <button data-close-drawers class="cursor-pointer font-mono text-[12px] text-soft">Close ✕</button>
        </div>
        <h2 class="font-sf m-0 text-[26px]">Private vault</h2>
        <div data-vault-lines class="flex flex-col"></div>
        <button data-move-all class="btn-keeper hidden self-start px-5 py-3 [&.show]:block">Move all to bag</button>
      </div>
    </div>

    <!-- ── Acquisition bag drawer ── -->
    <div data-bag-modal class="fixed inset-0 z-[45] hidden justify-end bg-[oklch(0.22_0.006_0/0.42)] [&.open]:flex">
      <div class="anim-slide flex w-[min(480px,100%)] flex-col gap-[22px] overflow-y-auto border-l border-rule bg-paper p-[clamp(20px,4vw,36px)]">
        <div class="flex items-baseline gap-4">
          <span class="eti text-faint">Acquisition bag</span>
          <span class="flex-1"></span>
          <button data-close-drawers class="cursor-pointer font-mono text-[12px] text-soft">Close ✕</button>
        </div>
        <h2 class="font-sf m-0 text-[26px]">Your bag</h2>
        <div data-bag-lines class="flex flex-col"></div>
        <div data-bag-total-row class="hidden flex-wrap items-center gap-x-4 gap-y-3 border-t border-rule pt-[18px] [&.show]:flex">
          <span class="eti text-faint">Total valuation</span>
          <span class="flex-1"></span>
          <span data-bag-total class="font-mono text-[17px]"></span>
        </div>
        <button data-request-keeper class="btn-keeper hidden self-stretch px-5 py-3.5 text-center [&.show]:block">Request the keeper</button>
        <p data-bag-requested class="m-0 hidden text-[13px] leading-[1.7] text-acc [&.show]:block">The keeper has received your request and will reply within one business day with a private valuation.</p>
      </div>
    </div>

    <!-- ── ⌘K Search ── -->
    <div data-search-modal class="fixed inset-0 z-50 hidden justify-center overflow-y-auto bg-[oklch(0.97_0.002_0/0.97)] px-3 pb-3 pt-4 sm:px-6 sm:pb-6 sm:pt-[12vh] [&.open]:flex">
      <div class="anim-fade flex w-[min(720px,100%)] flex-col gap-[26px]">
        <div class="flex items-baseline gap-4">
          <span class="eti text-faint">Search the archives</span>
          <span class="flex-1"></span>
          <button data-search-close class="cursor-pointer font-mono text-[12px] text-soft">Close esc</button>
        </div>
        <input data-search-input placeholder="Reference, calibre, material or name" autocomplete="off"
          class="font-sf w-full border-0 border-b border-acc bg-transparent px-0.5 py-3 text-[clamp(22px,4vw,30px)] text-ink outline-none placeholder:text-faint" />
        <div data-search-suggestions class="no-scrollbar flex gap-2.5 overflow-x-auto sm:flex-wrap sm:overflow-visible"></div>
        <div data-search-results class="flex flex-col"></div>
      </div>
    </div>

    <!-- ── Auth ── -->
    <div data-auth-modal class="fixed inset-0 z-[60] hidden items-start justify-center overflow-y-auto bg-[oklch(0.22_0.006_0/0.46)] p-0 sm:px-5 sm:pb-5 sm:pt-[8vh] [&.open]:flex">
      <div class="anim-fade flex min-h-full w-full flex-col gap-5 border-0 bg-card p-4 pt-6 sm:min-h-0 sm:w-[min(440px,100%)] sm:border sm:border-rule sm:p-[clamp(24px,4vw,36px)]">
        <div class="flex items-baseline gap-4">
          <span data-auth-meta class="eti text-acc"></span>
          <span class="flex-1"></span>
          <button data-auth-close class="cursor-pointer font-mono text-[12px] text-soft">✕</button>
        </div>
        <h2 data-auth-title class="font-sf m-0 text-[27px]">Patron sign-in</h2>
        <label data-auth-arms class="hidden flex-col gap-[7px] [&.show]:flex">
          <span class="eti text-faint">Arms or family name</span>
          <input data-af="arms" class="w-full rounded-[2px] border border-rule bg-transparent px-3 py-[11px] text-[14px] text-ink outline-none focus:border-faint" />
        </label>
        <label class="flex flex-col gap-[7px]">
          <span class="eti text-faint">Registered address</span>
          <input data-af="email" type="email" placeholder="you@example.com" class="w-full rounded-[2px] border border-rule bg-transparent px-3 py-[11px] text-[14px] text-ink outline-none focus:border-faint" />
        </label>
        <label class="flex flex-col gap-[7px]">
          <span class="eti text-faint">Passphrase</span>
          <input data-af="pass" type="password" class="w-full rounded-[2px] border border-rule bg-transparent px-3 py-[11px] text-[14px] text-ink outline-none focus:border-faint" />
        </label>
        <p data-auth-error class="m-0 hidden text-[13px] text-acc [&.show]:block"></p>
        <button data-auth-submit class="btn-keeper px-5 py-3.5 text-center">Patron sign-in</button>
        <button data-auth-switch class="cursor-pointer text-center text-[13px] text-acc">Register new arms</button>
        <div class="flex flex-col gap-3 border-t border-line pt-4">
          <span class="eti text-faint">Or enter as an existing patron</span>
          <div data-quick-patrons class="flex flex-col gap-2.5"></div>
        </div>
      </div>
    </div>

    <div data-toast class="anim-fade fixed bottom-8 left-1/2 z-[90] hidden -translate-x-1/2 whitespace-nowrap border border-rule bg-ink px-4 py-2.5 font-mono text-[12px] tracking-[0.04em] text-card"></div>

    <script>
      import { bag, vault, toggleIn, patron, currency, CURRENCIES, fmtMoney, type Currency } from '../lib/stores';

      const D = JSON.parse(document.body.dataset.maison!);
      const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
      (window as any).MAISON = D;

      const HEART = (on: boolean, cls = 'ico-sm') => `<svg class="${cls}" viewBox="0 0 24 24" fill="${on ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;
      const BAG_ICO = `<svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`;
      const HOUSE_KEY = 'njx-maison-house';
      const getHouse = () => localStorage.getItem(HOUSE_KEY) ?? 'horlogerie';
      const houseOf = (h: string) => D.houses.find((x: any) => x.handle === h) ?? D.houses[0];
      const pieceBy = (h: string) => D.pieces.find((p: any) => p.handle === h);
      (window as any).maisonGetHouse = getHouse;
      const money = (usd: number) => fmtMoney(usd, currency.get() as Currency);
      (window as any).maisonMoney = money;

      function setHouse(h: string) {
        localStorage.setItem(HOUSE_KEY, h);
        paintChrome();
        document.dispatchEvent(new CustomEvent('maison:house', { detail: h }));
      }
      (window as any).maisonSetHouse = setHouse;

      // ── toast ──
      let toastT: number;
      function toast(msg: string) {
        const t = $('[data-toast]');
        t.textContent = msg;
        t.classList.remove('hidden');
        clearTimeout(toastT);
        toastT = window.setTimeout(() => t.classList.add('hidden'), 2200);
      }
      (window as any).maisonToast = toast;

      // ── chrome ──
      function paintChrome() {
        const h = houseOf(getHouse());
        $('[data-house-tabs]').innerHTML = D.houses.map((x: any) => `
          <button data-house="${x.handle}" class="cursor-pointer ${x.handle === h.handle ? 'tab-on' : 'text-muted transition hover:text-ink'}">${x.short}</button>`).join('');
        $('[data-house-dd-label]').textContent = h.short;
        $('[data-house-dd-list]').innerHTML = D.houses.filter((x: any) => x.handle !== h.handle).map((x: any) => `
          <button data-house="${x.handle}" class="cursor-pointer text-left text-muted transition hover:text-ink">${x.short}</button>`).join('');
        $('[data-house-meta]').textContent = h.meta;
        $('[data-house-name]').textContent = h.name;
        $('[data-auth-meta]').textContent = h.meta;
        paintMega();
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-house-dd-btn]')) { $('[data-house-dd-list]').classList.toggle('open'); return; }
        const b = t.closest<HTMLElement>('[data-house]');
        if (b) setHouse(b.dataset.house!);
        if (b || !t.closest('[data-house-dd]')) $('[data-house-dd-list]').classList.remove('open');
      });

      // ── mega ──
      const mega = $('[data-mega]');
      const megaBtn = $('[data-mega-btn]');
      function setMega(open: boolean) {
        mega.classList.toggle('open', open);
        megaBtn.classList.toggle('open', open);
      }
      megaBtn.addEventListener('click', () => setMega(!mega.classList.contains('open')));
      function paintMega() {
        const h = houseOf(getHouse());
        $('[data-mega-cols]').innerHTML = h.mega.map((col: any) => `
          <div class="flex min-w-0 flex-[1_1_210px] flex-col gap-4">
            <div class="eti text-acc" style="font-size:10px">${col.title}</div>
            ${col.links.map((l: string[]) => `
              <button data-mega-link class="group flex cursor-pointer flex-col gap-[3px] text-left">
                <span class="font-sf text-[16px] transition group-hover:text-acc">${l[0]}</span>
                <span class="text-[12.5px] leading-[1.55] text-muted">${l[1]}</span>
              </button>`).join('')}
          </div>`).join('');
        $('[data-mega-image]').textContent = h.megaImage;
        $('[data-mega-visual]').style.backgroundImage = h.megaImageSrc ? `url('${h.megaImageSrc}')` : '';
        $('[data-mega-title]').textContent = h.megaTitle;
        $('[data-mega-manifesto]').textContent = h.manifesto;
      }
      mega.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-mega-close]')) return setMega(false);
        if ((e.target as HTMLElement).closest('[data-mega-link]')) {
          setMega(false);
          document.getElementById('archive')?.scrollIntoView({ behavior: 'smooth' });
          if (!document.querySelector('[data-catalog]')) location.href = '/#archive';
        }
      });

      // ── currency-aware money repaint ──
      function repaintMoney() {
        document.querySelectorAll<HTMLElement>('[data-usd]').forEach((el) => {
          el.textContent = money(Number(el.dataset.usd));
        });
      }
      currency.subscribe(() => { repaintMoney(); renderBag(); document.dispatchEvent(new CustomEvent('maison:currency')); });

      // ── piece drawer ──
      function lineRow(p: any, extra: string): string {
        return `
          <div class="flex flex-wrap items-start gap-x-[18px] gap-y-3 border-t border-line py-4">
            <button data-open-piece="${p.handle}" class="hatch aspect-[4/5] w-[58px] flex-none cursor-pointer border border-line bg-cover bg-center" style="background-image:url('${p.image}')"></button>
            <div class="flex min-w-0 flex-[1_1_180px] flex-col gap-1.5">
              <button data-open-piece="${p.handle}" class="font-sf cursor-pointer text-left text-[17px] leading-[1.3]">${p.name}</button>
              <span class="font-mono text-[11px] text-faint">${p.ref} · <span data-usd="${p.price}">${money(p.price)}</span></span>
              <div class="eti flex gap-4" style="font-size:10.5px">${extra}</div>
            </div>
          </div>`;
      }
      function openPiece(handle: string) {
        const p = pieceBy(handle);
        if (!p) return;
        closeAll();
        const inVault = vault.get().includes(p.handle);
        const inBag = bag.get().includes(p.handle);
        const avail = p.bespoke ? 'Bespoke commission only' : (p.stock ? 'Held in the vault' : 'On request from the keeper');
        $('[data-piece-box]').innerHTML = `
          <div class="flex flex-col gap-6">
            <div class="flex items-baseline gap-4">
              <span class="eti text-faint">${p.ref}</span>
              <span class="flex-1"></span>
              <button data-piece-close class="cursor-pointer font-mono text-[12px] text-soft">Close ✕</button>
            </div>
            <div class="hatch flex aspect-[3/2] items-end border border-line bg-cover bg-center p-3.5" style="background-image:url('${p.image}')">
              <span class="bg-card px-1.5 py-[3px] font-mono text-[10px] tracking-[0.08em] text-faint">${p.kind}</span>
            </div>
            <div class="flex flex-col gap-2.5">
              <span class="eti text-faint">${p.brand}</span>
              <h2 class="font-sf m-0 text-[clamp(24px,3.4vw,30px)] leading-[1.15]">${p.name}</h2>
              <p class="m-0 mt-1.5 text-[14.5px] leading-[1.75] text-soft">${p.note}</p>
            </div>
            <div class="flex flex-col">
              ${[['Reference', p.ref], ['Material', p.material], ['Era', p.epoch], ['Origin', p.origin], ['Specification', p.spec], ['Availability', avail], ['Patron rating', p.rating.toFixed(1) + '★']].map(([k, v]) => `
                <div class="flex flex-wrap gap-x-[18px] gap-y-1 border-t border-line py-3">
                  <span class="eti w-[140px] flex-none text-faint" style="font-size:10.5px">${k}</span>
                  <span class="min-w-0 flex-1 text-[13.5px] text-ink">${v}</span>
                </div>`).join('')}
            </div>
            <a href="/products/${p.handle}" class="eti text-acc" style="font-size:10.5px">Open the full record →</a>
            <div class="flex flex-wrap items-center gap-x-[14px] gap-y-3.5 border-t border-rule pt-5">
              <span class="font-mono text-[17px]" data-usd="${p.price}">${money(p.price)}</span>
              <span class="flex-1"></span>
              <button data-piece-save="${p.handle}" title="${inVault ? 'Remove from vault' : 'Save to vault'}" class="pin-btn ${inVault ? 'is-on' : ''}" style="width:42px;height:42px">${HEART(inVault, 'ico')}</button>
              <button data-piece-bag="${p.handle}" class="btn-keeper flex items-center gap-2 px-[22px] py-[13px] ${inBag ? 'is-on' : ''}">${BAG_ICO}<span>${inBag ? 'In the bag ✓' : 'Add to bag'}</span></button>
            </div>
            <div class="text-[12.5px] leading-[1.6] text-muted">${p.bespoke ? 'Book the atelier' : 'Request this piece'} — the keeper replies within one business day.</div>
          </div>`;
        $('[data-piece-modal]').classList.add('open');
      }
      (window as any).maisonOpenPiece = openPiece;
      document.addEventListener('maison:open' as any, (e: CustomEvent) => openPiece(e.detail));
      $('[data-piece-modal]').addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (e.target === $('[data-piece-modal]') || t.closest('[data-piece-close]')) return $('[data-piece-modal]').classList.remove('open');
        const sv = t.closest<HTMLElement>('[data-piece-save]');
        if (sv) { toggleIn(vault, sv.dataset.pieceSave!); openPiece(sv.dataset.pieceSave!); return; }
        const bg = t.closest<HTMLElement>('[data-piece-bag]');
        if (bg) { const added = toggleIn(bag, bg.dataset.pieceBag!); toast(added ? 'Placed in the acquisition bag' : 'Removed from the bag'); openPiece(bg.dataset.pieceBag!); }
      });
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-open-piece]');
        if (b) openPiece(b.dataset.openPiece!);
      });

      // ── vault + bag ──
      const closeAll = () => {
        ['[data-piece-modal]', '[data-vault-modal]', '[data-bag-modal]', '[data-search-modal]', '[data-auth-modal]'].forEach((s) => $(s).classList.remove('open'));
        setMega(false);
      };
      $('[data-vault-btn]').addEventListener('click', () => { closeAll(); $('[data-vault-modal]').classList.add('open'); renderVault(); });
      $('[data-bag-btn]').addEventListener('click', () => { closeAll(); $('[data-bag-modal]').classList.add('open'); renderBag(); });
      document.querySelectorAll('[data-close-drawers]').forEach((b) => b.addEventListener('click', closeAll));
      ['[data-vault-modal]', '[data-bag-modal]'].forEach((s) =>
        $(s).addEventListener('click', (e) => { if (e.target === $(s)) closeAll(); }));

      function renderVault() {
        const list = vault.get();
        $('[data-vault-n]').textContent = String(list.length);
        $('[data-vault-ico]').setAttribute('fill', list.length ? 'currentColor' : 'none');
        const box = $('[data-vault-lines]');
        box.innerHTML = list.length
          ? list.map((h) => { const p = pieceBy(h); return p ? lineRow(p, `
              <button data-line-bag="${p.handle}" class="cursor-pointer text-acc">${bag.get().includes(p.handle) ? 'In the bag ✓' : 'Add to bag'}</button>
              <button data-line-unsave="${p.handle}" class="cursor-pointer text-faint">Remove</button>`) : ''; }).join('')
          : '<p class="m-0 py-4 text-[14px] leading-[1.7] text-muted">Nothing saved yet. Use Save on any piece to keep it in your vault.</p>';
        $('[data-move-all]').classList.toggle('show', list.length > 0);
      }
      function renderBag() {
        const list = bag.get();
        $('[data-bag-n]').textContent = String(list.length);
        const box = $('[data-bag-lines]');
        const pieces = list.map(pieceBy).filter(Boolean);
        box.innerHTML = pieces.length
          ? pieces.map((p: any) => lineRow(p, `
              <span class="text-faint normal-case tracking-normal" style="font-family:Cousine,monospace">${p.bespoke ? 'Bespoke' : p.stock ? 'In vault' : 'On request'}</span>
              <button data-line-unbag="${p.handle}" class="cursor-pointer text-faint">Remove</button>`)).join('')
          : '<p class="m-0 py-4 text-[14px] leading-[1.7] text-muted">The bag is empty. Add a piece and the keeper will prepare a valuation.</p>';
        const total = pieces.reduce((n: number, p: any) => n + p.price, 0);
        $('[data-bag-total-row]').classList.toggle('show', pieces.length > 0);
        $('[data-bag-total]').textContent = money(total);
        $('[data-request-keeper]').classList.toggle('show', pieces.length > 0);
        $('[data-bag-requested]').classList.remove('show');
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const lb = t.closest<HTMLElement>('[data-line-bag]');
        if (lb) { toggleIn(bag, lb.dataset.lineBag!); renderVault(); return; }
        const lu = t.closest<HTMLElement>('[data-line-unsave]');
        if (lu) { toggleIn(vault, lu.dataset.lineUnsave!); return; }
        const ub = t.closest<HTMLElement>('[data-line-unbag]');
        if (ub) { toggleIn(bag, ub.dataset.lineUnbag!); }
      });
      $('[data-move-all]').addEventListener('click', () => {
        const merged = [...new Set([...bag.get(), ...vault.get()])];
        bag.set(merged);
        closeAll();
        $('[data-bag-modal]').classList.add('open');
        renderBag();
      });
      $('[data-request-keeper]').addEventListener('click', () => {
        $('[data-bag-requested]').classList.add('show');
        $('[data-thanks-modal]').classList.add('open');
      });
      $('[data-thanks-modal]').addEventListener('click', (e) => {
        if (e.target === $('[data-thanks-modal]') || (e.target as HTMLElement).closest('[data-thanks-close]'))
          $('[data-thanks-modal]').classList.remove('open');
      });
      vault.subscribe(() => { renderVault(); document.dispatchEvent(new CustomEvent('maison:saved-changed')); });
      bag.subscribe(() => { renderBag(); document.dispatchEvent(new CustomEvent('maison:bag-changed')); });

      // ── search ──
      const searchModal = $('[data-search-modal]');
      const sInput = $('[data-search-input]') as HTMLInputElement;
      const openSearch = () => { closeAll(); searchModal.classList.add('open'); paintSearch(); setTimeout(() => sInput.focus(), 30); };
      const closeSearch = () => { searchModal.classList.remove('open'); sInput.value = ''; };
      $('[data-search-open]').addEventListener('click', openSearch);
      $('[data-search-close]').addEventListener('click', closeSearch);
      searchModal.addEventListener('click', (e) => { if (e.target === searchModal) closeSearch(); });
      function paintSearch() {
        const h = houseOf(getHouse());
        $('[data-search-suggestions]').innerHTML = (h.suggestions ?? []).map((s: string) => `
          <button data-sq="${esc(s)}" class="flex-none whitespace-nowrap cursor-pointer rounded-[2px] border border-rule px-3 py-[7px] text-[12.5px] text-soft transition hover:border-acc hover:text-acc">${s}</button>`).join('');
        const q = sInput.value.trim().toLowerCase();
        const results = q
          ? D.pieces.filter((p: any) => (p.name + ' ' + p.ref + ' ' + p.brand + ' ' + p.material + ' ' + p.spec + ' ' + p.note).toLowerCase().includes(q)).slice(0, 7)
          : [];
        $('[data-search-results]').innerHTML = q
          ? results.length
            ? results.map((p: any) => `
                <button data-open-piece="${p.handle}" class="flex cursor-pointer flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-line py-[15px] text-left transition hover:bg-card">
                  <span class="flex min-w-0 flex-[1_1_240px] flex-col gap-[5px]">
                    <span class="font-sf text-[17px]">${p.name}</span>
                    <span class="font-mono text-[10.5px] tracking-[0.08em] text-faint">${p.spec}</span>
                  </span>
                  <span class="font-mono text-[12.5px] text-soft" data-usd="${p.price}">${money(p.price)}</span>
                </button>`).join('')
            : '<div class="py-7 text-[14px] text-faint">Nothing found in the archive.</div>'
          : '';
      }
      sInput.addEventListener('input', paintSearch);
      searchModal.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-sq]');
        if (b) { sInput.value = b.dataset.sq!; paintSearch(); }
      });

      // ── auth + patron chrome ──
      const PATRONS = [
        { id: 'p1', name: 'Alexander Vereshchagin', status: 'Grand Collector VIP', registry: 'Patron no. 0147', since: '1998' },
        { id: 'p2', name: 'Eleonora Stein', status: 'Master Guild', registry: 'Patron no. 0312', since: '2011' },
      ];
      (window as any).MAISON_PATRONS = PATRONS;
      let authMode: 'signin' | 'register' = 'signin';
      const authModal = $('[data-auth-modal]');
      const openAuth = () => { closeAll(); authModal.classList.add('open'); paintAuth(); };
      (window as any).maisonOpenAuth = openAuth;
      $('[data-auth-btn]').addEventListener('click', openAuth);
      $('[data-auth-close]').addEventListener('click', () => authModal.classList.remove('open'));
      authModal.addEventListener('click', (e) => { if (e.target === authModal) authModal.classList.remove('open'); });
      function paintAuth() {
        $('[data-auth-title]').textContent = authMode === 'signin' ? 'Patron sign-in' : 'Register new arms';
        $('[data-auth-submit]').textContent = authMode === 'signin' ? 'Patron sign-in' : 'Register new arms';
        $('[data-auth-switch]').textContent = authMode === 'signin' ? 'Register new arms' : 'Back to sign-in';
        $('[data-auth-arms]').classList.toggle('show', authMode === 'register');
        $('[data-auth-error]').classList.remove('show');
        $('[data-quick-patrons]').innerHTML = PATRONS.map((p) => `
          <button data-quick-patron="${p.id}" class="flex cursor-pointer flex-col gap-[3px] border border-line px-3.5 py-3 text-left transition hover:border-acc">
            <span class="font-sf text-[16px]">${p.name}</span>
            <span class="font-mono text-[10.5px] text-faint">${p.status} · ${p.registry}</span>
          </button>`).join('');
      }
      $('[data-auth-switch]').addEventListener('click', () => { authMode = authMode === 'signin' ? 'register' : 'signin'; paintAuth(); });
      function signIn(session: any) {
        patron.set(session);
        authModal.classList.remove('open');
        paintPatron();
        toast(`Welcome, ${session.name.split(' ')[0]}`);
        location.href = '/account';
      }
      $('[data-auth-submit]').addEventListener('click', () => {
        const email = (document.querySelector('[data-af="email"]') as HTMLInputElement).value.trim();
        const pass = (document.querySelector('[data-af="pass"]') as HTMLInputElement).value;
        const err = $('[data-auth-error]');
        if (!email.includes('@') || pass.length < 4) {
          err.textContent = 'A registered address and a passphrase of four characters or more are required.';
          err.classList.add('show');
          return;
        }
        if (authMode === 'register') {
          const arms = (document.querySelector('[data-af="arms"]') as HTMLInputElement).value.trim() || email.split('@')[0];
          signIn({ id: 'p-' + Date.now(), name: arms, status: 'Registered Patron', registry: 'Patron no. ' + String(400 + Math.floor(Math.random() * 500)), since: 'this season' });
        } else {
          signIn({ ...PATRONS[0], name: email.split('@')[0].replace(/[._]/g, ' ') || PATRONS[0].name });
        }
      });
      authModal.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-quick-patron]');
        if (b) signIn(PATRONS.find((p) => p.id === b.dataset.quickPatron)!);
      });
      function paintPatron() {
        const p = patron.get();
        const link = $('[data-patron-link]');
        link.classList.toggle('show', !!p);
        if (p) link.textContent = p.name.split(' ')[0];
        $('[data-auth-btn]').classList.toggle('hide', !!p);
      }
      patron.subscribe(paintPatron);

      // ── keys ──
      document.addEventListener('keydown', (e) => {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName);
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
        if (e.key === '/' && !typing && !searchModal.classList.contains('open')) { e.preventDefault(); openSearch(); }
        if (e.key === 'Escape') closeAll();
      });
      document.addEventListener('maison:house', () => paintSearch());
      document.addEventListener('maison:toast' as any, (e: CustomEvent) => toast(e.detail));
      // pages toggle vault/bag through this event — the layout owns the stores
      function toggleFor(kind: string, handle: string) {
        const added = toggleIn(kind === 'vault' ? vault : bag, handle);
        toast(kind === 'vault'
          ? (added ? 'Saved to your private vault' : 'Removed from the vault')
          : (added ? 'Placed in the acquisition bag' : 'Removed from the bag'));
      }
      document.addEventListener('maison:toggle' as any, (e: CustomEvent) => {
        const { kind, handle } = e.detail ?? {};
        if (handle) toggleFor(kind, handle);
      });
      // card-level heart / bag buttons work on every page
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const sv = t.closest<HTMLElement>('[data-card-save]');
        if (sv) { toggleFor('vault', sv.dataset.cardSave!); return; }
        const bg = t.closest<HTMLElement>('[data-card-bag]');
        if (bg) toggleFor('bag', bg.dataset.cardBag!);
      });

      paintChrome();
      renderVault();
      renderBag();
      paintPatron();
      repaintMoney();
    </script>
  </body>
</html>
